rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and sub-collections
    match /users/{userId} {
      allow get, list, create, update, delete: if isValidId(userId) && isOwner(userId);

      match /messages/{messageId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
      }

      match /knowledge/{docId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }

      match /telemetry/{logId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(logId) && isOwner(userId);
      }
    }
  }
}
