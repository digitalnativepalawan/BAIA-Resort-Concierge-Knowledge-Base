{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and settings for TALA OS",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user identity" },
        "selectedVoiceName": { "type": "string", "maxLength": 100 },
        "apiProvider": { "type": "string", "enum": ["openrouter", "google"] },
        "selectedOpenRouterModel": { "type": "string", "maxLength": 100 },
        "selectedGoogleModel": { "type": "string", "maxLength": 100 },
        "autoSpeak": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "continuousListening": { "type": "boolean" },
        "useHybridNeural": { "type": "boolean" },
        "pitch": { "type": "number" },
        "rate": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Voice or text conversation message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string", "maxLength": 10000 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "role", "text", "timestamp"]
    },
    "KnowledgeDoc": {
      "title": "KnowledgeDoc",
      "description": "Grounded document uploaded to TALA memory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "size": { "type": "number" },
        "content": { "type": "string", "maxLength": 50000 },
        "type": { "type": "string", "maxLength": 64 },
        "uploadedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "content"]
    },
    "TelemetryLog": {
      "title": "TelemetryLog",
      "description": "System event and voice telemetry log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["info", "listening", "processing", "speaking", "error", "success", "system"] },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "message", "type", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User settings and profile document"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "#/entities/ChatMessage",
      "description": "User conversation messages"
    },
    "/users/{userId}/knowledge/{docId}": {
      "schema": "#/entities/KnowledgeDoc",
      "description": "Grounded documents uploaded by user"
    },
    "/users/{userId}/telemetry/{logId}": {
      "schema": "#/entities/TelemetryLog",
      "description": "User telemetry logs"
    }
  }
}
